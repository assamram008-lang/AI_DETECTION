# Copy this file to .env and replace every example value before running the API.
APP_SECRET_KEY=replace-with-at-least-32-random-characters
DOCTOR_USERNAME=doctor
DOCTOR_PASSWORD=replace-with-a-unique-strong-password
# Comma-separated exact browser origins; do not use *.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
AI_BODY_SCAN_DATABASE=backend/data/scans.sqlite3
AI_BODY_SCAN_DATA_DIR=backend/data/private
# Set to a positive number to automatically remove images from older scans at server startup.
# Zero keeps images until a patient or doctor deletes them in the app.
IMAGE_RETENTION_DAYS=0
